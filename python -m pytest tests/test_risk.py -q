import time
import pandas as pd
import pytest
import ana

def test_position_size_respects_risk_and_position_caps():
    cons = {"amount_step": 1e-8, "amount_min": 0.0, "cost_min": 0.0, "amount_max": None}
    qty, why = ana.RISK.position_size(1000.0, 100.0, 98.0, cons)
    assert qty > 0
    assert qty * 100.0 <= 1000.0 * ana.CONFIG.risk.max_position_value_pct / 100.0 + 1e-9

def test_position_size_rejects_invalid_stop():
    cons = {"amount_step": 1e-8, "amount_min": 0.0, "cost_min": 0.0, "amount_max": None}
    qty, why = ana.RISK.position_size(1000.0, 100.0, 102.0, cons)
    assert qty == 0.0

def test_compute_sl_tp_fallback():
    sl, tp = ana.compute_sl_tp(ana.CONFIG.risk, 100.0, None)
    assert sl < 100.0 and tp > 100.0

def test_regime_classifies_volatile():
    df = pd.DataFrame({"ts": pd.date_range("2025-01-01", periods=30, freq="15min", tz="UTC"),
                       "open": 100.0, "high": 120.0, "low": 80.0,
                       "close": 100.0, "volume": 1.0})
    ind = {"atr_pct": 99.0, "adx": 25.0, "ema50": 100.0, "ema200": None}
    assert ana.REGIME.classify(df, ind) == "volatile"

def test_regime_classifies_trend_up():
    df = pd.DataFrame({"ts": pd.date_range("2025-01-01", periods=30, freq="15min", tz="UTC"),
                       "open": 100.0, "high": 101.0, "low": 99.0,
                       "close": 100.0, "volume": 1.0})
    ind = {"atr_pct": 1.0, "adx": 30.0, "ema50": 99.0, "ema200": 95.0}
    assert ana.REGIME.classify(df, ind) == "trend_up"

def test_trailing_only_moves_up():
    pf = ana.Portfolio("paper", 10_000.0, 0.001, 5.0)
    ex = ana.ExecutionEngineV2(ana.ADAPTER, pf, ana.CONFIG, ana.DB)
    pf.positions["T/USDT"] = ana.Position(symbol="T/USDT", side="long", amount=1.0,
                                          entry_price=100.0, stop_loss=98.0,
                                          take_profit=200.0, opened_at=time.time())
    ex.entry_ctx["T/USDT"] = {"sl_initial": 98.0}
    prev = pf.positions["T/USDT"].stop_loss
    for price in (101.0, 103.0, 104.0):
        ex.check_stops("T/USDT", price)
        cur = pf.positions["T/USDT"].stop_loss
        assert cur >= prev
        prev = cur
