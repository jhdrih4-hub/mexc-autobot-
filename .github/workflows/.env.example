# Kopyala -> .env olarak kaydet (lokal) veya GitHub Secrets/Variables'a gir.
# ASLA gerçek değerleri repoya commit ETME.

# --- MOD ---
TRADING_MODE=paper            # paper | backtest | live
LIVE_ARM=no                   # canlı için "yes" GEREKLİ (çıkartma talimatı: sen)
KILL_SWITCH=no                # yes -> tüm yeni girişler anında durur

# --- ANAHTARLAR (GitHub Secret) ---
MEXC_API_KEY=
MEXC_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- EVREN ---
TOP_N_SYMBOLS=20              # hacme göre otomatik top-N
UNIVERSE_REFRESH_HOURS=12
# SYMBOLS=BTC/USDT,ETH/USDT   # boşsa otomatik top-N kullanılır

# --- PİYASA / DÖNGÜ ---
PRIMARY_TIMEFRAME=15m
HIGHER_TIMEFRAME=4h
POLL_SECONDS=60
MAX_RUNTIME_MINUTES=30        # 0 = sınırsız (Actions'ta 30 kullan)
DATA_DIR=data

# --- PAPER ---
PAPER_START_BALANCE=10000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# --- STRATEJİ / SKOR ---
BUY_SCORE_THRESHOLD=0.35
SELL_SCORE_THRESHOLD=-0.35
MIN_AGREEMENT=0.6
MIN_NONFLAT_SIGNALS=3
NEWS_TILT_MAX=0.10
# STRATEGY_WEIGHTS={"trend_follow":1.2}

# --- RISK (RISK_ önekiyle hepsi override edilebilir) ---
# RISK_MAX_RISK_PER_TRADE_PCT=1.0
# RISK_MAX_POSITION_VALUE_PCT=20
# RISK_MAX_TOTAL_EXPOSURE_PCT=60
# RISK_MAX_DAILY_LOSS_PCT=3
# RISK_MAX_DRAWDOWN_PCT=15
# RISK_MAX_OPEN_POSITIONS=5

# --- ML / BACKTEST / DİĞER ---
ML_ENABLED=no
BACKTEST_DAYS=30
CLOSE_ON_STOP=no
CLOSE_ON_KILL=no
TELEGRAM_ENABLED=yes
